# Chưa có Supabase thì app tự dùng dữ liệu mẫu (lib/db/demo-places.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Đăng nhập (US2, chưa làm)
FACEBOOK_APP_ID=
GOOGLE_OAUTH_CLIENT_ID=

# Ô tìm địa chỉ (T034, chưa chọn VietMap hay Goong)
GEOCODER_API_KEY=

# Bản đồ nền. Để trống thì dùng OpenFreeMap (miễn phí, không cần khoá) cho tới khi có file PMTiles (T018).
NEXT_PUBLIC_MAP_STYLE_URL=

# AI luôn tắt mặc định (hiến chương + plan.md)
AI_SUGGEST_ENABLED=false
LOCATION_SUGGEST_ENABLED=false
